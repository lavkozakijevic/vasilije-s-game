{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/hud/**",
              "components/menu/**",
              "guidelines/**",
              "ui_kits/game/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Jacquard 24|Pixelify Sans|Silkscreen))/i]",
        "message": "Font not provided by the design system. Available: Jacquard 24, Pixelify Sans, Silkscreen."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoinCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|digits|scale|src|spin|key|ref|className|style|children)$/]",
        "message": "<CoinCounter> doesn't accept that prop. Declared props: count, digits, scale, src, spin."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElementBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:element|icon|scale|active|label|key|ref|className|style|children)$/]",
        "message": "<ElementBadge> doesn't accept that prop. Declared props: element, icon, scale, active, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElementBadge'] > JSXAttribute[name.name='element'] > Literal[value!=/^(?:fire|water|earth|air|ice|lightning|shadow|light)$/]",
        "message": "<ElementBadge> element must be one of 'fire' | 'water' | 'earth' | 'air' | 'ice' | 'lightning' | 'shadow' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeartMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|scale|src|key|ref|className|style|children)$/]",
        "message": "<HeartMeter> doesn't accept that prop. Declared props: value, max, scale, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PixelButton> doesn't accept that prop. Declared props: children, variant, size, disabled, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<PixelButton> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PixelButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|tone|padding|style|key|ref|className|style|children)$/]",
        "message": "<PixelPanel> doesn't accept that prop. Declared props: children, title, tone, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PixelPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:stone|dark|parchment)$/]",
        "message": "<PixelPanel> tone must be one of 'stone' | 'dark' | 'parchment'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sprite'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|frames|frameWidth|frameHeight|scale|fps|loop|flip|playing|frame|style|key|ref|className|style|children)$/]",
        "message": "<Sprite> doesn't accept that prop. Declared props: src, frames, frameWidth, frameHeight, scale, fps, loop, flip, playing, frame, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
